# Intended path: /backend/.env
# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# Mongo connection string - when running via docker-compose, use the service name "mongo"
MONGO_URI=mongodb://mongo:27017/wildflowersandwaves

# Comma separated list of allowed origins for CORS
CLIENT_URL=http://localhost:3000

# Nodemailer (used by the contact form to send a notification email)
# Example uses Gmail SMTP - generate an "app password", do not use your real password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER_EMAIL=info@wildflowersandwaves.co.za
