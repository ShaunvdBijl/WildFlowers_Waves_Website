
PORT=5000
NODE_ENV=development

# Mongo connection string - when running via docker-compose, use the service name "mongo"
MONGO_URI=mongodb://mongo:27017/wildflowersandwaves

# Comma separated list of allowed origins for CORS
CLIENT_URL=http://localhost:3000

# Nodemailer (used by the contact form to send a notification email)
# Example uses Gmail SMTP - generate an "app password", do not use your real password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER_EMAIL=info@wildflowersandwaves.co.za

# Firebase Admin SDK - used by middleware/auth.js to verify client ID tokens.
# Easiest option: paste the ENTIRE downloaded service-account JSON on one line here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Alternative to the single JSON var above - set these three individually instead:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"